{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "apps/api/gradlew",
      "runtimeArgs": ["-p", "apps/api", "bootRun"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web"],
      "port": 3001,
      "url": "http://localhost:3000"
    }
  ]
}
