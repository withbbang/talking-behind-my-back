<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.chat.message.MessageMapper">

  <resultMap id="messageMap" type="com.example.chat.message.Message">
    <id     property="id"               column="id"/>
    <result property="roomId"           column="room_id"/>
    <result property="senderUserId"     column="sender_user_id"/>
    <result property="senderNickname"   column="sender_nickname"/>
    <result property="role"             column="role"/>
    <result property="content"          column="content"/>
    <result property="inputType"        column="input_type"/>
    <result property="mode"             column="mode"/>
    <result property="model"            column="model"/>
    <result property="promptTokens"     column="prompt_tokens"/>
    <result property="completionTokens" column="completion_tokens"/>
    <result property="createdAt"        column="created_at"/>
  </resultMap>

  <!-- 조회는 users LEFT JOIN 으로 sender_nickname 을 채운다(T-021, D-023). 나간 멤버도 users 행이 있으면 이름 유지. -->
  <sql id="columns">
    m.id, m.room_id, m.sender_user_id, u.nickname AS sender_nickname, m.role, m.content, m.input_type, m.mode, m.model, m.prompt_tokens, m.completion_tokens, m.created_at
  </sql>
  <sql id="fromJoined">
    FROM messages m
    LEFT JOIN users u ON u.id = m.sender_user_id
  </sql>

  <insert id="insert" parameterType="com.example.chat.message.Message" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO messages (room_id, sender_user_id, role, content, input_type, mode, model, prompt_tokens, completion_tokens)
    VALUES (#{roomId}, #{senderUserId}, #{role}, #{content}, #{inputType}, #{mode}, #{model}, #{promptTokens}, #{completionTokens})
  </insert>

  <select id="findById" resultMap="messageMap">
    SELECT <include refid="columns"/>
    <include refid="fromJoined"/>
    WHERE m.id = #{id}
  </select>

  <select id="findByRoomId" resultMap="messageMap">
    SELECT <include refid="columns"/>
    <include refid="fromJoined"/>
    <where>
      m.room_id = #{roomId}
      <if test="cursorId != null">AND m.id &lt; #{cursorId}</if>
    </where>
    ORDER BY m.id DESC
    LIMIT #{size}
  </select>

  <select id="findRecentByRoomId" resultMap="messageMap">
    SELECT <include refid="columns"/>
    <include refid="fromJoined"/>
    WHERE m.room_id = #{roomId}
    ORDER BY m.id DESC
    LIMIT #{limit}
  </select>

  <select id="countByRoomId" resultType="long">
    SELECT COUNT(*) FROM messages WHERE room_id = #{roomId}
  </select>

</mapper>
