# cp .env.example .env 후 값 채우기. .env는 git에 올리지 않음.

# ---- compose ----
APP_NAME=talking-behind-my-back     # 이미지/컨테이너 이름 접두어 (소문자, GitHub 레포명과 동일)
GH_OWNER=withbbang                  # ghcr.io/<GH_OWNER>/<APP_NAME>-web  ← 반드시 소문자
IMAGE_TAG=latest                    # 배포 시 GH Actions가 커밋 SHA로 덮어씀
DATA_DIR=/volume1/docker/talking-behind-my-back/data

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chat_app
MYSQL_USER=chat_app
MYSQL_PASSWORD=

# ---- API: 도메인/세션 ----
APP_BASE_URL=https://chat.example.com     # OAuth redirect, 초대 URL, 쿠키 Secure/Domain 기준
APP_TIME_ZONE=Asia/Seoul                  # DB DATETIME → API UTC 변환 기준. compose mysql TZ 와 같아야 한다
JWT_SECRET=                               # openssl rand -base64 48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d                       # "앱 껐다 켜도 로그인 유지" 기간

# ---- API: 소셜 로그인 ----
# redirect URI는 각 콘솔에 아래 형식으로 등록 (로컬용 http://localhost:3000/api/login/oauth2/code/{provider} 도 함께):
#   ${APP_BASE_URL}/api/login/oauth2/code/google
#   ${APP_BASE_URL}/api/login/oauth2/code/naver
#   ${APP_BASE_URL}/api/login/oauth2/code/kakao
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=                    # 카카오 REST API 키
OAUTH_KAKAO_CLIENT_SECRET=                # 카카오 콘솔에서 client secret 사용 설정한 경우만

# ---- API: LLM (OmniRoute) ----
# OMNIROUTE_BASE_URL은 compose에서 http://omniroute:20128/v1 로 고정
OMNIROUTE_API_KEY=                        # OmniRoute 대시보드 → API Manager에서 발급
LLM_MODEL=                                # OmniRoute에 등록한 모델 alias (예: chat-default)
LLM_CONTEXT_MAX_MESSAGES=30               # 방 히스토리 중 LLM에 넘길 최근 메시지 수
LLM_TIMEOUT_SECONDS=120
# AI 잡 스레드풀 (T-007, D-019). 생략 시 2/4/16. 초과 시 503 AI_BUSY
# AI_CORE_THREADS=2
# AI_MAX_THREADS=4
# AI_QUEUE_SIZE=16

# ---- API: STT / TTS (서버 방식, D-027: 기본은 LLM 과 같은 OmniRoute 의 /v1/audio/* 경유) ----
STT_PROVIDER=omniroute                    # omniroute | clova
TTS_PROVIDER=omniroute                    # omniroute | clova
STT_MODEL=groq/whisper-large-v3-turbo     # OmniRoute 규칙 provider/model. Groq 키는 OmniRoute 대시보드 → Providers → Groq 에 (D-028)
TTS_MODEL=edge/tts-1                      # OmniRoute 에 "OpenAI 호환" 노드로 등록한 edge-tts 사이드카(prefix edge, README#첫-배포-순서)
# SPEECH_TIMEOUT_SECONDS=30               # STT/TTS 공급자 호출 타임아웃
CLOVA_SPEECH_INVOKE_URL=                  # Clova Speech (STT) — provider=clova 일 때 (스텁)
CLOVA_SPEECH_SECRET=
CLOVA_VOICE_CLIENT_ID=                    # Clova Voice (TTS)
CLOVA_VOICE_CLIENT_SECRET=
TTS_VOICE=ko-KR-SunHiNeural               # Edge 음성: ko-KR-SunHiNeural(여) / ko-KR-InJoonNeural(남) / ko-KR-HyunsuMultilingualNeural. 비우면 안 됨(D-028)
