# cp .env.example .env 후 값 채우기. .env는 git에 올리지 않음.
# 빈 값 줄에는 인라인 주석을 두지 말 것 — compose env_file 은 값이 비면 뒤 '# 주석' 을 값으로 넣는다(T-012 NAS 실측). 주석은 윗줄에.

# ---- compose ----
APP_NAME=talking-behind-my-back     # 이미지/컨테이너 이름 접두어 (소문자, GitHub 레포명과 동일)
GH_OWNER=withbbang                  # ghcr.io/<GH_OWNER>/<APP_NAME>-web  ← 반드시 소문자
IMAGE_TAG=latest                    # 배포 시 GH Actions가 커밋 SHA로 덮어씀
DATA_DIR=/volume1/docker/talking-behind-my-back/data

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chat_app
MYSQL_USER=chat_app
MYSQL_PASSWORD=

# ---- API: 도메인/세션 ----
APP_BASE_URL=https://chat.example.com     # OAuth redirect, 초대 URL, 쿠키 Secure/Domain 기준
APP_TIME_ZONE=Asia/Seoul                  # DB DATETIME → API UTC 변환 기준. compose mysql TZ 와 같아야 한다
# openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d                       # "앱 껐다 켜도 로그인 유지" 기간

# ---- API: 소셜 로그인 ----
# redirect URI는 각 콘솔에 아래 형식으로 등록 (로컬용 http://localhost:3000/api/login/oauth2/code/{provider} 도 함께):
#   ${APP_BASE_URL}/api/login/oauth2/code/google
#   ${APP_BASE_URL}/api/login/oauth2/code/naver
#   ${APP_BASE_URL}/api/login/oauth2/code/kakao
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
# 카카오 REST API 키
OAUTH_KAKAO_CLIENT_ID=
# 카카오 콘솔에서 client secret 사용 설정한 경우만
OAUTH_KAKAO_CLIENT_SECRET=

# ---- API: 채팅 LLM (D-040·D-044) — 공급자 직접 호출, OmniRoute 없음 ----
# claude = Claude API(기본), gemini = Gemini OpenAI 호환 엔드포인트 직접(무료 롤백)
LLM_PROVIDER=claude
# console.anthropic.com 에서 발급. 비면 claude 호출이 401 로 실패한다(값 빈 줄엔 인라인 주석 금지 — env_file 이 값으로 넣음)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low                         # low|medium|high|xhigh|max
# 롤백용 Gemini — aistudio.google.com 에서 발급. LLM_PROVIDER=gemini 일 때만 필요
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest     # 무료 티어(D-032). flash-latest 같은 thinking 모델로 바꾸면 아래를 none 으로
# 비우면 안 보냄. flash-lite 는 이 파라미터를 400 거부하니 반드시 비울 것(D-031)
LLM_REASONING_EFFORT=
LLM_CONTEXT_MAX_MESSAGES=30               # 방 히스토리 중 LLM에 넘길 최근 메시지 수
LLM_TIMEOUT_SECONDS=120
# AI 잡 스레드풀 (T-007, D-019). 생략 시 2/4/16. 초과 시 503 AI_BUSY
# AI_CORE_THREADS=2
# AI_MAX_THREADS=4
# AI_QUEUE_SIZE=16

# ---- API: STT / TTS (서버 방식, D-044: STT = Groq 직접, TTS = Azure Speech 직접) ----
STT_PROVIDER=groq                         # groq | clova
TTS_PROVIDER=azure                        # azure | clova
# console.groq.com 에서 발급(무료 하루 28,800초·2,000회). 비면 STT 가 401 로 실패
GROQ_API_KEY=
STT_MODEL=whisper-large-v3                # Groq 모델명(D-028). turbo 는 정확도 낮음
# SPEECH_TIMEOUT_SECONDS=30               # STT/TTS 공급자 호출 타임아웃
# SPEECH_TMP_DIR=/tmp/audio               # 업로드·변환 임시 디렉터리 = compose tmpfs. Tomcat multipart location 도 같은 값
# Clova Speech (STT) — provider=clova 일 때 (스텁)
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# Clova Voice (TTS)
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
TTS_VOICE=ko-KR-SunHiNeural               # 언어 판정 불가 시 기본 voice(D-042). 비우면 기동 실패
# 답변 텍스트 언어(한글/영문/가나/한자)로 TTS voice 자동 선택(D-042). 판정 불가면 TTS_VOICE. 끄려면 false
TTS_AUTO_LANGUAGE=true
# 언어별 voice(Azure Neural 이름) — 생략 시 여성(D-043·D-044)
# TTS_VOICE_KO=ko-KR-SunHiNeural
# TTS_VOICE_EN=en-US-AriaNeural
# TTS_VOICE_JA=ja-JP-NanamiNeural
# TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
# Azure AI Speech (TTS, D-044) — portal.azure.com → Speech 리소스(F0 무료, Neural 월 50만 자) → 키 및 엔드포인트. 폴백 없음
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral           # 리소스를 만든 지역
