# cp .env.omniroute.example .env.omniroute
# 전체 변수 목록은 OmniRoute wiki → Environment 페이지 참고.

PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/app/data
NODE_ENV=production
STORAGE_DRIVER=sqlite

# api 컨테이너가 /v1 호출 시 API 키 필수 — 대시보드에서 키 발급 후 .env의 OMNIROUTE_API_KEY에 넣기
REQUIRE_API_KEY=true

# 대시보드는 LAN에서 http://<NAS-IP>:20128 로만 접근하므로 secure cookie 끔
AUTH_COOKIE_SECURE=false

# 공급자 자격증명 암호화 키 — openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# D-028: /v1/audio/* 가 localhost 밖 OpenAI 호환 노드(compose 의 edge-tts 사이드카, http://edge-tts:5050/v1)를 쓰게 허용.
# 대시보드 Settings → Feature flags 의 DB 값이 이 환경변수보다 우선한다.
AUDIO_REMOTE_PROVIDER_NODES=true

